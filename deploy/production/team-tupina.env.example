DJANGO_DEBUG=False
SECRET_KEY=replace-with-a-generated-random-secret-key-of-at-least-64-characters
SIGNING_KEY=replace-with-a-different-generated-random-signing-key-of-at-least-64-characters
SITE_URL=https://app.teamtupina.com.br
ALLOWED_HOSTS=app.teamtupina.com.br,teamtupina.com.br,www.teamtupina.com.br
CSRF_TRUSTED_ORIGINS=https://app.teamtupina.com.br,https://teamtupina.com.br,https://www.teamtupina.com.br
CORS_ALLOWED_ORIGINS=https://app.teamtupina.com.br,https://teamtupina.com.br,https://www.teamtupina.com.br
TIME_ZONE=America/Sao_Paulo

X_FORWARDED_PROTO_HEADER_SET=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

FROM_EMAIL=Team Tupina <no-reply@teamtupina.com.br>
ENABLE_EMAIL=True
EMAIL_HOST=smtp.exemplo.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@teamtupina.com.br
EMAIL_HOST_PASSWORD=troque-esta-senha
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

DJANGO_DB_ENGINE=django_prometheus.db.backends.postgresql
DJANGO_DB_DATABASE=wger_teamtupina
DJANGO_DB_USER=wger_teamtupina
DJANGO_DB_PASSWORD=troque-esta-senha
DJANGO_DB_HOST=postgres
DJANGO_DB_PORT=5432

DJANGO_CACHE_BACKEND=django_redis.cache.RedisCache
DJANGO_CACHE_LOCATION=redis://redis:6379/1
DJANGO_CACHE_TIMEOUT=300
DJANGO_CACHE_CLIENT_CLASS=django_redis.client.DefaultClient

CELERY_BROKER=redis://redis:6379/2
CELERY_BACKEND=redis://redis:6379/3
USE_CELERY=True

WGER_USE_GUNICORN=True
WGER_PORT=8000
DJANGO_PERFORM_MIGRATIONS=True
DJANGO_COLLECTSTATIC_ON_STARTUP=True
DJANGO_CLEAR_STATIC_FIRST=True

ALLOW_GUEST_USERS=False
ALLOW_REGISTRATION=False
ALLOW_UPLOAD_VIDEOS=True
DOWNLOAD_INGREDIENTS_FROM=WGER
SYNC_EXERCISES_CELERY=True
SYNC_EXERCISE_IMAGES_CELERY=True
SYNC_EXERCISE_VIDEOS_CELERY=False
SYNC_INGREDIENTS_CELERY=True

TEAM_TUPINA_SITE_URL=https://teamtupina.com.br
TEAM_TUPINA_PREMIUM_URL=https://teamtupina.com.br/premium
